<?xml version="1.0" encoding="utf-8"?>
<!-- RemoteViews chat line on os_chat_row: one pixel-text bitmap holding "Speaker: message" in two colours.
     Fill with OsChat.remote(...) / OsRemote.chatLine(...). Put it on an os_chatbox background. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/os_chat_line" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minHeight="28dp" android:background="@drawable/os_chat_row"
    android:paddingStart="8dp" android:paddingTop="4dp" android:paddingEnd="8dp" android:paddingBottom="4dp">
    <ImageView android:id="@+id/os_chat_line_text" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|start" />
</FrameLayout>
