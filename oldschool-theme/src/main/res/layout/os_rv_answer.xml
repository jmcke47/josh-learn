<?xml version="1.0" encoding="utf-8"?>
<!-- RemoteViews quiz answer: set background with setInt(id, "setBackgroundResource", OsRemote.answerBackground(r)). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/os_answer" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minHeight="@dimen/os_answer_min_height" android:background="@drawable/os_answer_normal">
    <ImageView android:id="@+id/os_answer_text" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center" android:importantForAccessibility="no" />
</FrameLayout>
