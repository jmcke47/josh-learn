<?xml version="1.0" encoding="utf-8"?>
<!-- RemoteViews skill tile: icon + "level/level" + optional label. Fill with OsRemote.skill(...). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/os_skill" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="@drawable/os_frame_filled" android:gravity="center_vertical" android:orientation="horizontal">
    <ImageView android:id="@+id/os_skill_icon" android:layout_width="32dp" android:layout_height="32dp"
        android:layout_marginEnd="6dp" android:contentDescription="@null" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <ImageView android:id="@+id/os_skill_level" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:importantForAccessibility="no" />
        <ImageView android:id="@+id/os_skill_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:importantForAccessibility="no" />
    </LinearLayout>
</LinearLayout>
