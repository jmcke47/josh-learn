<?xml version="1.0" encoding="utf-8"?>
<!-- RemoteViews inventory slot: emoji (plain TextView: emoji render in system font) + pixel label/count bitmaps.
     Fill with OsRemote.slot(...). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/os_slot" android:layout_width="@dimen/os_slot_size" android:layout_height="@dimen/os_slot_size"
    android:background="@drawable/os_slot_bg" android:padding="3dp">
    <TextView android:id="@+id/os_slot_emoji" android:layout_width="match_parent" android:layout_height="match_parent"
        android:layout_marginBottom="10dp" android:gravity="center" android:includeFontPadding="false" android:textSize="24sp" />
    <ImageView android:id="@+id/os_slot_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal" android:importantForAccessibility="no" />
    <ImageView android:id="@+id/os_slot_count" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="top|start" android:importantForAccessibility="no" android:visibility="gone" />
</FrameLayout>
