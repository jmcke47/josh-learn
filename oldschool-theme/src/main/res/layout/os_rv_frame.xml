<?xml version="1.0" encoding="utf-8"?>
<!-- RemoteViews widget frame: stone panel, pixel-text header (ImageView, render with OsRemote.pixelText),
     two header buttons, parchment list area. Set the ListView's adapter with setRemoteAdapter(R.id.os_rv_list, …). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/os_widget_bg" android:orientation="vertical" android:padding="8dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="36dp" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:id="@+id/os_rv_title" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:paddingHorizontal="6dp" android:scaleType="fitStart" android:contentDescription="@null" />
        <ImageView android:id="@+id/os_rv_button1" android:layout_width="36dp" android:layout_height="36dp" android:padding="6dp"
            android:background="@drawable/os_button" android:src="@drawable/os_ic_widget_mic" android:contentDescription="@null" />
        <ImageView android:id="@+id/os_rv_button2" android:layout_width="36dp" android:layout_height="36dp" android:padding="6dp"
            android:layout_marginStart="4dp" android:background="@drawable/os_button" android:src="@drawable/os_ic_widget_add"
            android:contentDescription="@null" />
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginTop="6dp" android:background="@drawable/os_chatbox" android:padding="4dp">
        <ListView android:id="@+id/os_rv_list" android:layout_width="match_parent" android:layout_height="match_parent"
            android:divider="@null" android:dividerHeight="3dp" />
        <TextView android:id="@+id/os_rv_empty" android:layout_width="match_parent" android:layout_height="match_parent"
            android:gravity="center" android:textColor="@color/os_ink" android:textSize="14sp" />
    </FrameLayout>
</LinearLayout>
