<?xml version="1.0" encoding="utf-8"?>
<!-- RemoteViews banner: parchment strip with icon + two pixel-text lines (e.g. "Daily lesson ready"). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/os_banner" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="@drawable/os_banner" android:gravity="center_vertical" android:orientation="horizontal" android:padding="10dp">
    <ImageView android:id="@+id/os_banner_icon" android:layout_width="32dp" android:layout_height="32dp"
        android:layout_marginEnd="8dp" android:contentDescription="@null" android:src="@drawable/os_ic_quill" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <ImageView android:id="@+id/os_banner_line1" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:importantForAccessibility="no" />
        <ImageView android:id="@+id/os_banner_line2" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:importantForAccessibility="no" />
    </LinearLayout>
</LinearLayout>
