<?xml version="1.0" encoding="utf-8"?>
<!-- v1.3 stone-button text: orange, yellow while pressed/focused, dim when disabled. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:color="@color/os_button_disabled_text" />
    <item android:state_pressed="true" android:color="@color/os_yellow" />
    <item android:state_focused="true" android:color="@color/os_yellow" />
    <item android:color="@color/os_orange" />
</selector>
