<?xml version="1.0" encoding="utf-8"?>
<!-- "OS Small": self-drawn pixel font (SIL OFL 1.1). Regular for body text, bold for headers. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <font android:font="@font/os_font_small" android:fontStyle="normal" android:fontWeight="400"
        app:font="@font/os_font_small" app:fontStyle="normal" app:fontWeight="400" />
    <font android:font="@font/os_font_small_bold" android:fontStyle="normal" android:fontWeight="700"
        app:font="@font/os_font_small_bold" app:fontStyle="normal" app:fontWeight="700" />
</font-family>
