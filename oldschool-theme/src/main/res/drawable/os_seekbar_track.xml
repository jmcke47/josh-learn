<?xml version="1.0" encoding="utf-8"?>
<!-- Stone groove with a gold fill. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <layer-list>
            <item><shape><solid android:color="#FF000000" /></shape></item>
            <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp"><shape><solid android:color="#FF8A7B62" /></shape></item>
            <item android:left="1dp" android:top="1dp" android:right="2dp" android:bottom="2dp"><shape><solid android:color="#FF1C1711" /></shape></item>
            <item android:left="3dp" android:top="3dp" android:right="2dp" android:bottom="2dp">
                <bitmap android:src="@drawable/os_stone_tile" android:tileMode="repeat" android:filter="false" /></item>
            <item android:left="3dp" android:top="3dp" android:right="2dp" android:bottom="2dp"><shape><solid android:color="#99000000" /></shape></item>
        </layer-list>
    </item>
    <item android:id="@android:id/secondaryProgress" android:left="3dp" android:top="3dp" android:right="2dp" android:bottom="2dp">
        <clip><shape><solid android:color="#665B4F3D" /></shape></clip>
    </item>
    <item android:id="@android:id/progress" android:left="3dp" android:top="3dp" android:right="2dp" android:bottom="2dp">
        <clip>
            <layer-list>
                <item><shape><solid android:color="@color/os_gold" /></shape></item>
                <item android:bottom="3dp"><shape><solid android:color="@color/os_xp_gold" /></shape></item>
                <item android:bottom="5dp"><shape><solid android:color="#FFFFE68A" /></shape></item>
            </layer-list>
        </clip>
    </item>
</layer-list>
