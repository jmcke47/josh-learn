<?xml version="1.0" encoding="utf-8"?>
<!-- XP bar: gold over dark stone, black outline. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <layer-list>
            <item><shape><solid android:color="#FF000000" /></shape></item>
            <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp"><shape><solid android:color="#FF2A241C" /></shape></item>
        </layer-list>
    </item>
    <item android:id="@android:id/progress" android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <clip><layer-list>
            <item><shape><solid android:color="@color/os_gold" /></shape></item>
            <item android:bottom="6dp"><shape><solid android:color="@color/os_xp_gold" /></shape></item>
        </layer-list></clip>
    </item>
</layer-list>
