<?xml version="1.0" encoding="utf-8"?>
<!-- Quiz answer: correct/wrong custom states win over pressed. Widgets: use os_answer_normal/_correct/_wrong directly. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <item app:os_state_correct="true" android:drawable="@drawable/os_answer_correct" />
    <item app:os_state_wrong="true" android:drawable="@drawable/os_answer_wrong" />
    <item android:state_pressed="true" android:drawable="@drawable/os_answer_pressed" />
    <item android:state_focused="true" android:drawable="@drawable/os_answer_pressed" />
    <item android:drawable="@drawable/os_answer_normal" />
</selector>
