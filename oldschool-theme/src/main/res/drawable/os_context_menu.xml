    <item><shape><solid android:color="@color/os_menu_bg" /></shape></item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape><solid android:color="#00000000" /><stroke android:width="1dp" android:color="#FF000000" /></shape></item>
</layer-list>
