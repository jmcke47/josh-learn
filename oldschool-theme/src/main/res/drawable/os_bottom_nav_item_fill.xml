<?xml version="1.0" encoding="utf-8"?>
<!-- Labelled BottomNav item: the side-tab stone stretched over the whole item (icon + label). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true"><inset android:inset="2dp" android:drawable="@drawable/os_side_tab_down" /></item>
    <item android:state_selected="true"><inset android:inset="2dp" android:drawable="@drawable/os_side_tab_down" /></item>
    <item android:state_pressed="true"><inset android:inset="2dp" android:drawable="@drawable/os_side_tab_down" /></item>
    <item><inset android:inset="2dp" android:drawable="@drawable/os_side_tab_up" /></item>
</selector>
