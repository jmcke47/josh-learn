<?xml version="1.0" encoding="utf-8"?>
<!-- Menu row: the text turns yellow (os_menu_option_text); only a faint darkening behind it. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"><shape><solid android:color="#1F000000" /></shape></item>
    <item android:state_focused="true"><shape><solid android:color="#14000000" /></shape></item>
    <item><shape><solid android:color="#00000000" /></shape></item>
</selector>
