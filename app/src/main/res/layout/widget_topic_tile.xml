<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tile_frame" android:layout_width="match_parent" android:layout_height="120dp" android:padding="4dp">
    <LinearLayout android:id="@+id/tile_root" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:gravity="center" android:background="@drawable/widget_tile_bg"
        android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="8dp" android:paddingBottom="8dp">
        <TextView android:id="@+id/tile_emoji" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="36sp" android:maxLines="1" android:includeFontPadding="false" android:text="🔬" />
        <TextView android:id="@+id/tile_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:gravity="center" android:maxLines="2" android:ellipsize="end"
            android:hyphenationFrequency="none" android:breakStrategy="simple"
            android:textColor="@color/widget_on_tile" android:textSize="15sp" android:textStyle="bold" android:text="Science" />
    </LinearLayout>
</FrameLayout>
