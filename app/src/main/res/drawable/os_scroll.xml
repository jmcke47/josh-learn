<?xml version="1.0" encoding="utf-8"?>
<!-- Parchment scroll with rolled ends (original). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="6dp" android:right="6dp"><shape><solid android:color="#FF2B1D0C" /></shape></item>
    <item android:left="7dp" android:right="7dp" android:top="12dp" android:bottom="12dp"><bitmap android:src="@drawable/os_parchment_tile" android:tileMode="repeat" android:filter="false" /></item>
    <item android:left="7dp" android:right="7dp" android:top="12dp" android:bottom="12dp"><shape><solid android:color="#00000000" /><stroke android:width="3dp" android:color="#40593A12" /></shape></item>
    <item android:gravity="top" android:height="14dp"><shape><gradient android:angle="90" android:startColor="#FF6B4A20" android:centerColor="#FFD9C08A" android:endColor="#FF6B4A20" /><stroke android:width="1dp" android:color="#FF2B1D0C" /></shape></item>
    <item android:gravity="bottom" android:height="14dp"><shape><gradient android:angle="90" android:startColor="#FF6B4A20" android:centerColor="#FFD9C08A" android:endColor="#FF6B4A20" /><stroke android:width="1dp" android:color="#FF2B1D0C" /></shape></item>
</layer-list>
